cabal-version:      3.0
name:               social-network
version:            0.1.0.0
synopsis:           A minimal social network modelled as a directed container comonad
license:            MIT
author:             Robin Langer
build-type:         Simple

common shared
  default-language: GHC2021
  default-extensions:
    DataKinds
    DeriveGeneric
    DerivingStrategies
    GeneralizedNewtypeDeriving
    OverloadedStrings
    TypeFamilies
    TypeOperators
  ghc-options: -Wall -Wno-unused-do-bind

library
  import: shared
  hs-source-dirs: src
  exposed-modules:
    SocialNetwork.Types
    SocialNetwork.Container
    SocialNetwork.Api
    SocialNetwork.Server
    SocialNetwork.Db
  build-depends:
    , base           >= 4.18 && < 5
    , aeson          >= 2.1
    , bytestring
    , containers
    , mtl
    , servant        >= 0.20
    , servant-server >= 0.20
    , text           >= 2.0
    , time
    , wai
    , warp
    , sqlite-simple  >= 0.4

executable social-network
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends:
    , base
    , social-network
